rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only the authenticated user may read/write their own doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Pairings: only members may read pairing docs and logs
    match /pairings/{pairingId} {
      // Allow creation when the request includes a memberIds list that contains the creator
      allow create: if request.auth != null
                    && request.resource.data.memberIds is list
                    && request.auth.uid in request.resource.data.memberIds;

      // Members may read their pairings. A single-result query is also kept
      // for the existing invite-code lookup used while joining a pairing.
      allow get: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow list: if request.auth != null && (
        request.auth.uid in resource.data.memberIds
        || request.query.limit <= 1
      );

      // Allow client-side update only for two narrow member-list changes:
      // (a) joining — the requester adds themself via arrayUnion, nothing else
      //     changes; or (b) leaving/account deletion — the requester removes
      //     only themself, nothing else changes. No other field or member can
      // ever be touched by a client update.
      allow update: if request.auth != null && (
        ( // Join
          !(request.auth.uid in resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
        ) || ( // Leave
          request.auth.uid in resource.data.memberIds
          && !(request.auth.uid in request.resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        )
      );
      allow delete: if false;

      // Logs subcollection
      match /logs/{logId} {
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/pairings/$(pairingId)).data.memberIds;
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/pairings/$(pairingId)).data.memberIds;
        // Members may only ever touch the reactions map on a log (emoji
        // reactions) — every other field is immutable once created, and
        // deletes are still disallowed entirely.
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/pairings/$(pairingId)).data.memberIds
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if false;
      }

      // Celebrations subcollection — written only by Cloud Functions (Admin SDK,
      // bypasses these rules); clients only ever read them.
      match /celebrations/{celebrationId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/pairings/$(pairingId)).data.memberIds;
        allow write: if false;
      }

      // Streaks subcollection (read-only from client)
      match /streaks/{streakId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/pairings/$(pairingId)).data.memberIds;
        allow write: if false;
      }
    }

  }
}

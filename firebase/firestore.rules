rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only the authenticated user may read/write their own doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Pairings: only members may read pairing docs and logs
    match /pairings/{pairingId} {
      // Allow creation when the request includes a memberIds list that contains the creator
      allow create: if request.auth != null
                    && request.resource.data.memberIds is list
                    && request.auth.uid in request.resource.data.memberIds;

      // Reads allowed to members
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;

      // Allow client-side update only to add a new member via invite acceptance.
      // This is a pragmatic allowance for MVP: the update must include the requesting user in the new memberIds list.
      allow update: if request.auth != null
                    && request.auth.uid in request.resource.data.memberIds;
      allow delete: if false;

      // Logs subcollection
      match /logs/{logId} {
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/pairings/$(pairingId)).data.memberIds;
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/pairings/$(pairingId)).data.memberIds;
        // Disallow client-side deletes/updates to logs for safety; handle via server/cloud functions if needed
        allow update, delete: if false;
      }

      // Streaks subcollection (read-only from client)
      match /streaks/{streakId} {
        allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
        allow write: if false;
      }
    }

  }
}